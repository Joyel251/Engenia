generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum EventDivision {
  ONSTAGE
  OFFSTAGE
}

model Department {
  id           String        @id @default(cuid())
  name         String        @unique
  points       Int           @default(0)
  winners      Winner[]
  achievements Achievement[]
}

model Event {
  id        String        @id @default(cuid())
  name      String
  status    EventStatus   @default(UPCOMING)
  division  EventDivision
  date      DateTime
  points    Json          @default("{}") // points per position, e.g. { "1": 10, "2": 7, "3": 5 }
  winners   Winner[]
}

model Winner {
  id           String     @id @default(cuid())
  event        Event      @relation(fields: [eventId], references: [id])
  eventId      String
  department   Department @relation(fields: [deptId], references: [id])
  deptId       String
  position     Int
  studentName  String?
}

model Achievement {
  id         String     @id @default(cuid())
  department Department @relation(fields: [deptId], references: [id])
  deptId     String
  badgeName  String
}

model Settings {
  id                 String @id @default(cuid())
  leaderboardVisible Boolean @default(true)
  lockdown           Boolean @default(false)
}
